{
  "private": true,
  "workspaces": [
    "bootstrap-tools",
    "cat-harness",
    "cat-harness-tools",
    "folio-assistant-core",
    "fhir-harness"
  ],
  "scripts": {
    "cat": "bun cat-harness-tools/scripts/run-script.ts",
    "l1:verbatim": "python3 tools/l1/check-l1-verbatim.py",
    "l1-scenarios:uganda": "bun run smart-base/scripts/l1-recommendation-scenarios.ts --l1 library/l1-recommendation-scenarios/uganda/ug-moh-schedule-poster.l1.yaml --vocabulary library/l1-recommendation-scenarios/uganda/immz-vocabulary.json --generic smart-base/scripts/fixtures/l1-recommendation-scenarios/smart-base-generic-personas.json --mapping library/l1-recommendation-scenarios/uganda/ug-moh-schedule-poster-mapping.yaml --out library/l1-recommendation-scenarios/uganda/candidates/ug-moh-schedule-poster && bun run smart-base/scripts/l1-recommendation-scenarios.ts --l1 library/l1-recommendation-scenarios/uganda/unepi-deck.l1.yaml --vocabulary library/l1-recommendation-scenarios/uganda/immz-vocabulary.json --generic smart-base/scripts/fixtures/l1-recommendation-scenarios/smart-base-generic-personas.json --mapping library/l1-recommendation-scenarios/uganda/unepi-deck-mapping.yaml --out library/l1-recommendation-scenarios/uganda/candidates/unepi-deck",
    "l1-scenarios:uganda:check": "bun run smart-base/scripts/l1-recommendation-scenarios.ts --l1 library/l1-recommendation-scenarios/uganda/ug-moh-schedule-poster.l1.yaml --vocabulary library/l1-recommendation-scenarios/uganda/immz-vocabulary.json --generic smart-base/scripts/fixtures/l1-recommendation-scenarios/smart-base-generic-personas.json --mapping library/l1-recommendation-scenarios/uganda/ug-moh-schedule-poster-mapping.yaml --out library/l1-recommendation-scenarios/uganda/candidates/ug-moh-schedule-poster --check && bun run smart-base/scripts/l1-recommendation-scenarios.ts --l1 library/l1-recommendation-scenarios/uganda/unepi-deck.l1.yaml --vocabulary library/l1-recommendation-scenarios/uganda/immz-vocabulary.json --generic smart-base/scripts/fixtures/l1-recommendation-scenarios/smart-base-generic-personas.json --mapping library/l1-recommendation-scenarios/uganda/unepi-deck-mapping.yaml --out library/l1-recommendation-scenarios/uganda/candidates/unepi-deck --check",
    "l2:dmn": "python3 tools/l2/build-dmn.py",
    "l2:dmn:check": "python3 tools/l2/build-dmn.py --check",
    "review:render": "python3 tools/review/render-review.py"
  },
  "_comment": "As in litlfred/smart-immunizations: the mounted code layers as workspaces (they import each other by package name), and `bun run cat <name>` runs a declared script wherever its instance declares it."
}
