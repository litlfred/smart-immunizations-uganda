<dmn:definitions xmlns:dmn="https://www.omg.org/spec/DMN/20240513/MODEL/" namespace="https://litlfred.github.io/smart-immunizations-uganda" label="UG.D18.S.IPV Inactivated polio vaccine schedule (Uganda)" id="UG.D18.S.IPV">
  <dmn:decision id="UG.D18.S.IPV" label="UG.D18.S.IPV Inactivated polio vaccine schedule (Uganda)">
    <dmn:question>Which Inactivated polio vaccine dose is the client due for, and when?</dmn:question>
    <dmn:decisionTable id="UG.D18.S.IPV.table">
      <dmn:input id="UG.D18.S.IPV.input.doses" label="Number of Inactivated polio vaccine doses administered">
        <dmn:inputExpression id="UG.D18.S.IPV.inputExpression.doses" typeRef="string">
          <dmn:text>Count of vaccines administered (where "Vaccine type" = "Inactivated polio vaccine")</dmn:text>
        </dmn:inputExpression>
      </dmn:input>
      <dmn:input id="UG.D18.S.IPV.input.age" label="Age">
        <dmn:inputExpression id="UG.D18.S.IPV.inputExpression.age" typeRef="string">
          <dmn:text>Today's date − "Date of birth"</dmn:text>
        </dmn:inputExpression>
      </dmn:input>
      <dmn:input id="UG.D18.S.IPV.input.applies" label="Applicability">
        <dmn:inputExpression id="UG.D18.S.IPV.inputExpression.applies" typeRef="string">
          <dmn:text>Client's age is below the childhood catch-up upper age (parameter, default 5 years)</dmn:text>
        </dmn:inputExpression>
      </dmn:input>
      <dmn:output id="UG.D18.S.IPV.output.status" label="Recommendation status">
        <dmn:description>Due, upcoming, expired or complete</dmn:description>
      </dmn:output>
      <dmn:output id="UG.D18.S.IPV.output.due" label="Due date">
        <dmn:description>Date from which the dose may be given</dmn:description>
      </dmn:output>
      <dmn:output id="UG.D18.S.IPV.output.expiration" label="Expiration">
        <dmn:description>Last date on which the dose may be given</dmn:description>
      </dmn:output>
      <dmn:output id="UG.D18.S.IPV.output.guidance" label="Guidance displayed to health worker">
        <dmn:description>Request to communicate guidance to the health worker</dmn:description>
      </dmn:output>
      <dmn:output id="UG.D18.S.IPV.output.references" label="Reference(s)">
        <dmn:description>The L1 statements the rule rests on, as &lt;l1 file&gt;#&lt;key&gt;</dmn:description>
      </dmn:output>
      <dmn:rule id="UG.D18.S.IPV.rule.dose1">
        <dmn:inputEntry>
          <dmn:description>= 0</dmn:description>
          <dmn:text>0 dose(s) administered</dmn:text>
        </dmn:inputEntry>
        <dmn:inputEntry>
          <dmn:description>–</dmn:description>
          <dmn:text>–</dmn:text>
        </dmn:inputEntry>
        <dmn:inputEntry>
          <dmn:description>Client's age is below the childhood catch-up upper age (parameter, default 5 years)</dmn:description>
          <dmn:text>Applies</dmn:text>
        </dmn:inputEntry>
        <dmn:outputEntry>
          <dmn:description>"Immunization recommendation status" = "Due" when Due date ≤ Today, else "Upcoming"</dmn:description>
          <dmn:text>Client is due for Inactivated polio vaccine dose 1</dmn:text>
        </dmn:outputEntry>
        <dmn:outputEntry>
          <dmn:description>Date of birth + 6 weeks</dmn:description>
          <dmn:text>Date of birth + 6 weeks</dmn:text>
        </dmn:outputEntry>
        <dmn:outputEntry>
          <dmn:description>none</dmn:description>
          <dmn:text>none</dmn:text>
        </dmn:outputEntry>
        <dmn:outputEntry>
          <dmn:description>Guidance</dmn:description>
          <dmn:text>At 6 weeks, or as soon as possible thereafter. Intramuscular, right thigh, 2 cm from PCV.</dmn:text>
        </dmn:outputEntry>
        <dmn:outputEntry>
          <dmn:description>L1</dmn:description>
          <dmn:text>unepi-deck.l1.yaml#S07, unepi-deck.l1.yaml#C03, unepi-deck.l1.yaml#A04, unepi-deck.l1.yaml#C15</dmn:text>
        </dmn:outputEntry>
      </dmn:rule>
      <dmn:rule id="UG.D18.S.IPV.rule.dose2">
        <dmn:inputEntry>
          <dmn:description>= 1</dmn:description>
          <dmn:text>1 dose(s) administered</dmn:text>
        </dmn:inputEntry>
        <dmn:inputEntry>
          <dmn:description>–</dmn:description>
          <dmn:text>–</dmn:text>
        </dmn:inputEntry>
        <dmn:inputEntry>
          <dmn:description>Client's age is below the childhood catch-up upper age (parameter, default 5 years)</dmn:description>
          <dmn:text>Applies</dmn:text>
        </dmn:inputEntry>
        <dmn:outputEntry>
          <dmn:description>"Immunization recommendation status" = "Due" when Due date ≤ Today, else "Upcoming"</dmn:description>
          <dmn:text>Client is due for Inactivated polio vaccine dose 2</dmn:text>
        </dmn:outputEntry>
        <dmn:outputEntry>
          <dmn:description>Latest of (Date of birth + 14 weeks, previous IPV + 4 weeks)</dmn:description>
          <dmn:text>Latest of (Date of birth + 14 weeks, previous IPV + 4 weeks)</dmn:text>
        </dmn:outputEntry>
        <dmn:outputEntry>
          <dmn:description>none</dmn:description>
          <dmn:text>none</dmn:text>
        </dmn:outputEntry>
        <dmn:outputEntry>
          <dmn:description>Guidance</dmn:description>
          <dmn:text>At 14 weeks, or as soon as possible thereafter, and at least 4 weeks after the previous dose.</dmn:text>
        </dmn:outputEntry>
        <dmn:outputEntry>
          <dmn:description>L1</dmn:description>
          <dmn:text>unepi-deck.l1.yaml#S07, unepi-deck.l1.yaml#C05, unepi-deck.l1.yaml#C11, unepi-deck.l1.yaml#A04, unepi-deck.l1.yaml#C15</dmn:text>
        </dmn:outputEntry>
        <dmn:annotationEntry>
          <dmn:text>The catch-up chart labels the 14-week dose 'IPV1' (C05 scope); S07 names it dose 2.</dmn:text>
        </dmn:annotationEntry>
      </dmn:rule>
      <dmn:rule id="UG.D18.S.IPV.rule.expired">
        <dmn:inputEntry>
          <dmn:description>&lt; 2</dmn:description>
          <dmn:text>Series not complete</dmn:text>
        </dmn:inputEntry>
        <dmn:inputEntry>
          <dmn:description>Today &gt; none</dmn:description>
          <dmn:text>Past the expiration</dmn:text>
        </dmn:inputEntry>
        <dmn:inputEntry>
          <dmn:description>Client's age is below the childhood catch-up upper age (parameter, default 5 years)</dmn:description>
          <dmn:text>Applies</dmn:text>
        </dmn:inputEntry>
        <dmn:outputEntry>
          <dmn:description>"Immunization recommendation status" = "Expired"</dmn:description>
          <dmn:text>Do not give Inactivated polio vaccine</dmn:text>
        </dmn:outputEntry>
        <dmn:outputEntry>
          <dmn:description>–</dmn:description>
          <dmn:text>–</dmn:text>
        </dmn:outputEntry>
        <dmn:outputEntry>
          <dmn:description>none</dmn:description>
          <dmn:text>none</dmn:text>
        </dmn:outputEntry>
        <dmn:outputEntry>
          <dmn:description>Guidance</dmn:description>
          <dmn:text>The next Inactivated polio vaccine dose may no longer be given.</dmn:text>
        </dmn:outputEntry>
        <dmn:outputEntry>
          <dmn:description>L1</dmn:description>
          <dmn:text>unepi-deck.l1.yaml#C15</dmn:text>
        </dmn:outputEntry>
        <dmn:annotationEntry>
          <dmn:text>No expiration: this rule never applies (C15, no upper age limit).</dmn:text>
        </dmn:annotationEntry>
      </dmn:rule>
      <dmn:rule id="UG.D18.S.IPV.rule.complete">
        <dmn:inputEntry>
          <dmn:description>≥ 2</dmn:description>
          <dmn:text>Series complete</dmn:text>
        </dmn:inputEntry>
        <dmn:inputEntry>
          <dmn:description>–</dmn:description>
          <dmn:text>–</dmn:text>
        </dmn:inputEntry>
        <dmn:inputEntry>
          <dmn:description>–</dmn:description>
          <dmn:text>–</dmn:text>
        </dmn:inputEntry>
        <dmn:outputEntry>
          <dmn:description>"Immunization recommendation status" = "Complete"</dmn:description>
          <dmn:text>Inactivated polio vaccine series complete</dmn:text>
        </dmn:outputEntry>
        <dmn:outputEntry>
          <dmn:description>–</dmn:description>
          <dmn:text>–</dmn:text>
        </dmn:outputEntry>
        <dmn:outputEntry>
          <dmn:description>–</dmn:description>
          <dmn:text>–</dmn:text>
        </dmn:outputEntry>
        <dmn:outputEntry>
          <dmn:description>–</dmn:description>
          <dmn:text>–</dmn:text>
        </dmn:outputEntry>
        <dmn:outputEntry>
          <dmn:description>L1</dmn:description>
          <dmn:text>unepi-deck.l1.yaml#S07</dmn:text>
        </dmn:outputEntry>
      </dmn:rule>
      <dmn:rule id="UG.D18.S.IPV.rule.outOfScope">
        <dmn:inputEntry>
          <dmn:description>–</dmn:description>
          <dmn:text>–</dmn:text>
        </dmn:inputEntry>
        <dmn:inputEntry>
          <dmn:description>–</dmn:description>
          <dmn:text>–</dmn:text>
        </dmn:inputEntry>
        <dmn:inputEntry>
          <dmn:description>NOT (Client's age is below the childhood catch-up upper age (parameter, default 5 years))</dmn:description>
          <dmn:text>Childhood schedule does not apply</dmn:text>
        </dmn:inputEntry>
        <dmn:outputEntry>
          <dmn:description>"Immunization recommendation status" = "Not applicable"</dmn:description>
          <dmn:text>Not offered</dmn:text>
        </dmn:outputEntry>
        <dmn:outputEntry>
          <dmn:description>–</dmn:description>
          <dmn:text>–</dmn:text>
        </dmn:outputEntry>
        <dmn:outputEntry>
          <dmn:description>–</dmn:description>
          <dmn:text>–</dmn:text>
        </dmn:outputEntry>
        <dmn:outputEntry>
          <dmn:description>–</dmn:description>
          <dmn:text>–</dmn:text>
        </dmn:outputEntry>
        <dmn:outputEntry>
          <dmn:description>L1</dmn:description>
          <dmn:text>unepi-deck.l1.yaml#C15</dmn:text>
        </dmn:outputEntry>
        <dmn:annotationEntry>
          <dmn:text>Open question 1: until what age is the childhood schedule offered? C15 says only 'no upper age limit for most vaccines'.</dmn:text>
        </dmn:annotationEntry>
      </dmn:rule>
    </dmn:decisionTable>
  </dmn:decision>
</dmn:definitions>
