<dmn:definitions xmlns:dmn="https://www.omg.org/spec/DMN/20240513/MODEL/" namespace="https://litlfred.github.io/smart-immunizations-uganda" label="UG.D18.S.YellowFever Yellow fever schedule (Uganda)" id="UG.D18.S.YellowFever">
  <dmn:decision id="UG.D18.S.YellowFever" label="UG.D18.S.YellowFever Yellow fever schedule (Uganda)">
    <dmn:question>Which Yellow fever dose is the client due for, and when?</dmn:question>
    <dmn:decisionTable id="UG.D18.S.YellowFever.table">
      <dmn:input id="UG.D18.S.YellowFever.input.doses" label="Number of Yellow fever doses administered">
        <dmn:inputExpression id="UG.D18.S.YellowFever.inputExpression.doses" typeRef="string">
          <dmn:text>Count of vaccines administered (where "Vaccine type" = "Yellow fever")</dmn:text>
        </dmn:inputExpression>
      </dmn:input>
      <dmn:input id="UG.D18.S.YellowFever.input.age" label="Age">
        <dmn:inputExpression id="UG.D18.S.YellowFever.inputExpression.age" typeRef="string">
          <dmn:text>Today's date − "Date of birth"</dmn:text>
        </dmn:inputExpression>
      </dmn:input>
      <dmn:input id="UG.D18.S.YellowFever.input.applies" label="Applicability">
        <dmn:inputExpression id="UG.D18.S.YellowFever.inputExpression.applies" typeRef="string">
          <dmn:text>Client's age is below the childhood catch-up upper age (parameter, default 5 years)</dmn:text>
        </dmn:inputExpression>
      </dmn:input>
      <dmn:output id="UG.D18.S.YellowFever.output.status" label="Recommendation status">
        <dmn:description>Due, upcoming, expired or complete</dmn:description>
      </dmn:output>
      <dmn:output id="UG.D18.S.YellowFever.output.due" label="Due date">
        <dmn:description>Date from which the dose may be given</dmn:description>
      </dmn:output>
      <dmn:output id="UG.D18.S.YellowFever.output.expiration" label="Expiration">
        <dmn:description>Last date on which the dose may be given</dmn:description>
      </dmn:output>
      <dmn:output id="UG.D18.S.YellowFever.output.guidance" label="Guidance displayed to health worker">
        <dmn:description>Request to communicate guidance to the health worker</dmn:description>
      </dmn:output>
      <dmn:output id="UG.D18.S.YellowFever.output.references" label="Reference(s)">
        <dmn:description>The L1 statements the rule rests on, as &lt;l1 file&gt;#&lt;key&gt;</dmn:description>
      </dmn:output>
      <dmn:rule id="UG.D18.S.YellowFever.rule.dose1">
        <dmn:inputEntry>
          <dmn:description>= 0</dmn:description>
          <dmn:text>0 dose(s) administered</dmn:text>
        </dmn:inputEntry>
        <dmn:inputEntry>
          <dmn:description>–</dmn:description>
          <dmn:text>–</dmn:text>
        </dmn:inputEntry>
        <dmn:inputEntry>
          <dmn:description>Client's age is below the childhood catch-up upper age (parameter, default 5 years)</dmn:description>
          <dmn:text>Applies</dmn:text>
        </dmn:inputEntry>
        <dmn:outputEntry>
          <dmn:description>"Immunization recommendation status" = "Due" when Due date ≤ Today, else "Upcoming"</dmn:description>
          <dmn:text>Client is due for Yellow fever dose 1</dmn:text>
        </dmn:outputEntry>
        <dmn:outputEntry>
          <dmn:description>Date of birth + 9 months</dmn:description>
          <dmn:text>Date of birth + 9 months</dmn:text>
        </dmn:outputEntry>
        <dmn:outputEntry>
          <dmn:description>none</dmn:description>
          <dmn:text>none</dmn:text>
        </dmn:outputEntry>
        <dmn:outputEntry>
          <dmn:description>Guidance</dmn:description>
          <dmn:text>At 9 months, or as soon as possible thereafter; not before 9 months of age. Subcutaneous, right upper arm.</dmn:text>
        </dmn:outputEntry>
        <dmn:outputEntry>
          <dmn:description>L1</dmn:description>
          <dmn:text>unepi-deck.l1.yaml#S09, ug-moh-schedule-poster.l1.yaml#P08, unepi-deck.l1.yaml#C06, unepi-deck.l1.yaml#C12, unepi-deck.l1.yaml#A02, unepi-deck.l1.yaml#C15</dmn:text>
        </dmn:outputEntry>
      </dmn:rule>
      <dmn:rule id="UG.D18.S.YellowFever.rule.expired">
        <dmn:inputEntry>
          <dmn:description>&lt; 1</dmn:description>
          <dmn:text>Series not complete</dmn:text>
        </dmn:inputEntry>
        <dmn:inputEntry>
          <dmn:description>Today &gt; none</dmn:description>
          <dmn:text>Past the expiration</dmn:text>
        </dmn:inputEntry>
        <dmn:inputEntry>
          <dmn:description>Client's age is below the childhood catch-up upper age (parameter, default 5 years)</dmn:description>
          <dmn:text>Applies</dmn:text>
        </dmn:inputEntry>
        <dmn:outputEntry>
          <dmn:description>"Immunization recommendation status" = "Expired"</dmn:description>
          <dmn:text>Do not give Yellow fever</dmn:text>
        </dmn:outputEntry>
        <dmn:outputEntry>
          <dmn:description>–</dmn:description>
          <dmn:text>–</dmn:text>
        </dmn:outputEntry>
        <dmn:outputEntry>
          <dmn:description>none</dmn:description>
          <dmn:text>none</dmn:text>
        </dmn:outputEntry>
        <dmn:outputEntry>
          <dmn:description>Guidance</dmn:description>
          <dmn:text>The next Yellow fever dose may no longer be given.</dmn:text>
        </dmn:outputEntry>
        <dmn:outputEntry>
          <dmn:description>L1</dmn:description>
          <dmn:text>unepi-deck.l1.yaml#C15</dmn:text>
        </dmn:outputEntry>
        <dmn:annotationEntry>
          <dmn:text>No expiration: this rule never applies (C15, no upper age limit).</dmn:text>
        </dmn:annotationEntry>
      </dmn:rule>
      <dmn:rule id="UG.D18.S.YellowFever.rule.complete">
        <dmn:inputEntry>
          <dmn:description>≥ 1</dmn:description>
          <dmn:text>Series complete</dmn:text>
        </dmn:inputEntry>
        <dmn:inputEntry>
          <dmn:description>–</dmn:description>
          <dmn:text>–</dmn:text>
        </dmn:inputEntry>
        <dmn:inputEntry>
          <dmn:description>–</dmn:description>
          <dmn:text>–</dmn:text>
        </dmn:inputEntry>
        <dmn:outputEntry>
          <dmn:description>"Immunization recommendation status" = "Complete"</dmn:description>
          <dmn:text>Yellow fever series complete</dmn:text>
        </dmn:outputEntry>
        <dmn:outputEntry>
          <dmn:description>–</dmn:description>
          <dmn:text>–</dmn:text>
        </dmn:outputEntry>
        <dmn:outputEntry>
          <dmn:description>–</dmn:description>
          <dmn:text>–</dmn:text>
        </dmn:outputEntry>
        <dmn:outputEntry>
          <dmn:description>–</dmn:description>
          <dmn:text>–</dmn:text>
        </dmn:outputEntry>
        <dmn:outputEntry>
          <dmn:description>L1</dmn:description>
          <dmn:text>unepi-deck.l1.yaml#S09</dmn:text>
        </dmn:outputEntry>
      </dmn:rule>
      <dmn:rule id="UG.D18.S.YellowFever.rule.outOfScope">
        <dmn:inputEntry>
          <dmn:description>–</dmn:description>
          <dmn:text>–</dmn:text>
        </dmn:inputEntry>
        <dmn:inputEntry>
          <dmn:description>–</dmn:description>
          <dmn:text>–</dmn:text>
        </dmn:inputEntry>
        <dmn:inputEntry>
          <dmn:description>NOT (Client's age is below the childhood catch-up upper age (parameter, default 5 years))</dmn:description>
          <dmn:text>Childhood schedule does not apply</dmn:text>
        </dmn:inputEntry>
        <dmn:outputEntry>
          <dmn:description>"Immunization recommendation status" = "Not applicable"</dmn:description>
          <dmn:text>Not offered</dmn:text>
        </dmn:outputEntry>
        <dmn:outputEntry>
          <dmn:description>–</dmn:description>
          <dmn:text>–</dmn:text>
        </dmn:outputEntry>
        <dmn:outputEntry>
          <dmn:description>–</dmn:description>
          <dmn:text>–</dmn:text>
        </dmn:outputEntry>
        <dmn:outputEntry>
          <dmn:description>–</dmn:description>
          <dmn:text>–</dmn:text>
        </dmn:outputEntry>
        <dmn:outputEntry>
          <dmn:description>L1</dmn:description>
          <dmn:text>unepi-deck.l1.yaml#C15</dmn:text>
        </dmn:outputEntry>
        <dmn:annotationEntry>
          <dmn:text>Open question 1: until what age is the childhood schedule offered? C15 says only 'no upper age limit for most vaccines'.</dmn:text>
        </dmn:annotationEntry>
      </dmn:rule>
    </dmn:decisionTable>
  </dmn:decision>
</dmn:definitions>
