<dmn:definitions xmlns:dmn="https://www.omg.org/spec/DMN/20240513/MODEL/" namespace="https://litlfred.github.io/smart-immunizations-uganda" label="UG.D18.S.Rotavirus Rotavirus schedule (Uganda)" id="UG.D18.S.Rotavirus">
  <dmn:decision id="UG.D18.S.Rotavirus" label="UG.D18.S.Rotavirus Rotavirus schedule (Uganda)">
    <dmn:question>Which Rotavirus dose is the client due for, and when?</dmn:question>
    <dmn:decisionTable id="UG.D18.S.Rotavirus.table">
      <dmn:input id="UG.D18.S.Rotavirus.input.doses" label="Number of Rotavirus doses administered">
        <dmn:inputExpression id="UG.D18.S.Rotavirus.inputExpression.doses" typeRef="string">
          <dmn:text>Count of vaccines administered (where "Vaccine type" = "Rotavirus")</dmn:text>
        </dmn:inputExpression>
      </dmn:input>
      <dmn:input id="UG.D18.S.Rotavirus.input.age" label="Age">
        <dmn:inputExpression id="UG.D18.S.Rotavirus.inputExpression.age" typeRef="string">
          <dmn:text>Today's date − "Date of birth"</dmn:text>
        </dmn:inputExpression>
      </dmn:input>
      <dmn:input id="UG.D18.S.Rotavirus.input.applies" label="Applicability">
        <dmn:inputExpression id="UG.D18.S.Rotavirus.inputExpression.applies" typeRef="string">
          <dmn:text>Client's age is below the childhood catch-up upper age (parameter, default 5 years)</dmn:text>
        </dmn:inputExpression>
      </dmn:input>
      <dmn:output id="UG.D18.S.Rotavirus.output.status" label="Recommendation status">
        <dmn:description>Due, upcoming, expired or complete</dmn:description>
      </dmn:output>
      <dmn:output id="UG.D18.S.Rotavirus.output.due" label="Due date">
        <dmn:description>Date from which the dose may be given</dmn:description>
      </dmn:output>
      <dmn:output id="UG.D18.S.Rotavirus.output.expiration" label="Expiration">
        <dmn:description>Last date on which the dose may be given</dmn:description>
      </dmn:output>
      <dmn:output id="UG.D18.S.Rotavirus.output.guidance" label="Guidance displayed to health worker">
        <dmn:description>Request to communicate guidance to the health worker</dmn:description>
      </dmn:output>
      <dmn:output id="UG.D18.S.Rotavirus.output.references" label="Reference(s)">
        <dmn:description>The L1 statements the rule rests on, as &lt;l1 file&gt;#&lt;key&gt;</dmn:description>
      </dmn:output>
      <dmn:rule id="UG.D18.S.Rotavirus.rule.dose1">
        <dmn:inputEntry>
          <dmn:description>= 0</dmn:description>
          <dmn:text>0 dose(s) administered</dmn:text>
        </dmn:inputEntry>
        <dmn:inputEntry>
          <dmn:description>–</dmn:description>
          <dmn:text>–</dmn:text>
        </dmn:inputEntry>
        <dmn:inputEntry>
          <dmn:description>Client's age is below the childhood catch-up upper age (parameter, default 5 years)</dmn:description>
          <dmn:text>Applies</dmn:text>
        </dmn:inputEntry>
        <dmn:outputEntry>
          <dmn:description>"Immunization recommendation status" = "Due" when Due date ≤ Today, else "Upcoming"</dmn:description>
          <dmn:text>Client is due for Rotavirus dose 1</dmn:text>
        </dmn:outputEntry>
        <dmn:outputEntry>
          <dmn:description>Date of birth + 6 weeks</dmn:description>
          <dmn:text>Date of birth + 6 weeks</dmn:text>
        </dmn:outputEntry>
        <dmn:outputEntry>
          <dmn:description>Date of birth + 2 years − 1 day (not after 2 years of age)</dmn:description>
          <dmn:text>Date of birth + 2 years − 1 day (not after 2 years of age)</dmn:text>
        </dmn:outputEntry>
        <dmn:outputEntry>
          <dmn:description>Guidance</dmn:description>
          <dmn:text>At 6 weeks, or as soon as possible thereafter. Oral.</dmn:text>
        </dmn:outputEntry>
        <dmn:outputEntry>
          <dmn:description>L1</dmn:description>
          <dmn:text>unepi-deck.l1.yaml#S06, ug-moh-schedule-poster.l1.yaml#P02, unepi-deck.l1.yaml#C03, unepi-deck.l1.yaml#A01, unepi-deck.l1.yaml#C15</dmn:text>
        </dmn:outputEntry>
      </dmn:rule>
      <dmn:rule id="UG.D18.S.Rotavirus.rule.dose2">
        <dmn:inputEntry>
          <dmn:description>= 1</dmn:description>
          <dmn:text>1 dose(s) administered</dmn:text>
        </dmn:inputEntry>
        <dmn:inputEntry>
          <dmn:description>–</dmn:description>
          <dmn:text>–</dmn:text>
        </dmn:inputEntry>
        <dmn:inputEntry>
          <dmn:description>Client's age is below the childhood catch-up upper age (parameter, default 5 years)</dmn:description>
          <dmn:text>Applies</dmn:text>
        </dmn:inputEntry>
        <dmn:outputEntry>
          <dmn:description>"Immunization recommendation status" = "Due" when Due date ≤ Today, else "Upcoming"</dmn:description>
          <dmn:text>Client is due for Rotavirus dose 2</dmn:text>
        </dmn:outputEntry>
        <dmn:outputEntry>
          <dmn:description>Latest of (Date of birth + 10 weeks, previous rotavirus + 4 weeks)</dmn:description>
          <dmn:text>Latest of (Date of birth + 10 weeks, previous rotavirus + 4 weeks)</dmn:text>
        </dmn:outputEntry>
        <dmn:outputEntry>
          <dmn:description>Date of birth + 2 years − 1 day (not after 2 years of age)</dmn:description>
          <dmn:text>Date of birth + 2 years − 1 day (not after 2 years of age)</dmn:text>
        </dmn:outputEntry>
        <dmn:outputEntry>
          <dmn:description>Guidance</dmn:description>
          <dmn:text>At 10 weeks, or as soon as possible thereafter, and at least 4 weeks after dose 1.</dmn:text>
        </dmn:outputEntry>
        <dmn:outputEntry>
          <dmn:description>L1</dmn:description>
          <dmn:text>unepi-deck.l1.yaml#S06, ug-moh-schedule-poster.l1.yaml#P03, unepi-deck.l1.yaml#C04, unepi-deck.l1.yaml#C10, unepi-deck.l1.yaml#C15</dmn:text>
        </dmn:outputEntry>
      </dmn:rule>
      <dmn:rule id="UG.D18.S.Rotavirus.rule.dose3">
        <dmn:inputEntry>
          <dmn:description>= 2</dmn:description>
          <dmn:text>2 dose(s) administered</dmn:text>
        </dmn:inputEntry>
        <dmn:inputEntry>
          <dmn:description>–</dmn:description>
          <dmn:text>–</dmn:text>
        </dmn:inputEntry>
        <dmn:inputEntry>
          <dmn:description>Client's age is below the childhood catch-up upper age (parameter, default 5 years)</dmn:description>
          <dmn:text>Applies</dmn:text>
        </dmn:inputEntry>
        <dmn:outputEntry>
          <dmn:description>"Immunization recommendation status" = "Due" when Due date ≤ Today, else "Upcoming"</dmn:description>
          <dmn:text>Client is due for Rotavirus dose 3</dmn:text>
        </dmn:outputEntry>
        <dmn:outputEntry>
          <dmn:description>Latest of (Date of birth + 14 weeks, previous rotavirus + 4 weeks)</dmn:description>
          <dmn:text>Latest of (Date of birth + 14 weeks, previous rotavirus + 4 weeks)</dmn:text>
        </dmn:outputEntry>
        <dmn:outputEntry>
          <dmn:description>Date of birth + 2 years − 1 day (not after 2 years of age)</dmn:description>
          <dmn:text>Date of birth + 2 years − 1 day (not after 2 years of age)</dmn:text>
        </dmn:outputEntry>
        <dmn:outputEntry>
          <dmn:description>Guidance</dmn:description>
          <dmn:text>At 14 weeks, or as soon as possible thereafter, and at least 4 weeks after dose 2.</dmn:text>
        </dmn:outputEntry>
        <dmn:outputEntry>
          <dmn:description>L1</dmn:description>
          <dmn:text>unepi-deck.l1.yaml#S06, ug-moh-schedule-poster.l1.yaml#P04, unepi-deck.l1.yaml#C05, unepi-deck.l1.yaml#C11, unepi-deck.l1.yaml#C15</dmn:text>
        </dmn:outputEntry>
      </dmn:rule>
      <dmn:rule id="UG.D18.S.Rotavirus.rule.expired">
        <dmn:inputEntry>
          <dmn:description>&lt; 3</dmn:description>
          <dmn:text>Series not complete</dmn:text>
        </dmn:inputEntry>
        <dmn:inputEntry>
          <dmn:description>Today &gt; Date of birth + 2 years − 1 day (not after 2 years of age)</dmn:description>
          <dmn:text>Past the expiration</dmn:text>
        </dmn:inputEntry>
        <dmn:inputEntry>
          <dmn:description>Client's age is below the childhood catch-up upper age (parameter, default 5 years)</dmn:description>
          <dmn:text>Applies</dmn:text>
        </dmn:inputEntry>
        <dmn:outputEntry>
          <dmn:description>"Immunization recommendation status" = "Expired"</dmn:description>
          <dmn:text>Do not give Rotavirus</dmn:text>
        </dmn:outputEntry>
        <dmn:outputEntry>
          <dmn:description>–</dmn:description>
          <dmn:text>–</dmn:text>
        </dmn:outputEntry>
        <dmn:outputEntry>
          <dmn:description>Date of birth + 2 years − 1 day (not after 2 years of age)</dmn:description>
          <dmn:text>Date of birth + 2 years − 1 day (not after 2 years of age)</dmn:text>
        </dmn:outputEntry>
        <dmn:outputEntry>
          <dmn:description>Guidance</dmn:description>
          <dmn:text>The next Rotavirus dose may no longer be given.</dmn:text>
        </dmn:outputEntry>
        <dmn:outputEntry>
          <dmn:description>L1</dmn:description>
          <dmn:text>unepi-deck.l1.yaml#C09, unepi-deck.l1.yaml#C10, unepi-deck.l1.yaml#C11, unepi-deck.l1.yaml#C15</dmn:text>
        </dmn:outputEntry>
      </dmn:rule>
      <dmn:rule id="UG.D18.S.Rotavirus.rule.complete">
        <dmn:inputEntry>
          <dmn:description>≥ 3</dmn:description>
          <dmn:text>Series complete</dmn:text>
        </dmn:inputEntry>
        <dmn:inputEntry>
          <dmn:description>–</dmn:description>
          <dmn:text>–</dmn:text>
        </dmn:inputEntry>
        <dmn:inputEntry>
          <dmn:description>–</dmn:description>
          <dmn:text>–</dmn:text>
        </dmn:inputEntry>
        <dmn:outputEntry>
          <dmn:description>"Immunization recommendation status" = "Complete"</dmn:description>
          <dmn:text>Rotavirus series complete</dmn:text>
        </dmn:outputEntry>
        <dmn:outputEntry>
          <dmn:description>–</dmn:description>
          <dmn:text>–</dmn:text>
        </dmn:outputEntry>
        <dmn:outputEntry>
          <dmn:description>–</dmn:description>
          <dmn:text>–</dmn:text>
        </dmn:outputEntry>
        <dmn:outputEntry>
          <dmn:description>–</dmn:description>
          <dmn:text>–</dmn:text>
        </dmn:outputEntry>
        <dmn:outputEntry>
          <dmn:description>L1</dmn:description>
          <dmn:text>unepi-deck.l1.yaml#S06</dmn:text>
        </dmn:outputEntry>
      </dmn:rule>
      <dmn:rule id="UG.D18.S.Rotavirus.rule.outOfScope">
        <dmn:inputEntry>
          <dmn:description>–</dmn:description>
          <dmn:text>–</dmn:text>
        </dmn:inputEntry>
        <dmn:inputEntry>
          <dmn:description>–</dmn:description>
          <dmn:text>–</dmn:text>
        </dmn:inputEntry>
        <dmn:inputEntry>
          <dmn:description>NOT (Client's age is below the childhood catch-up upper age (parameter, default 5 years))</dmn:description>
          <dmn:text>Childhood schedule does not apply</dmn:text>
        </dmn:inputEntry>
        <dmn:outputEntry>
          <dmn:description>"Immunization recommendation status" = "Not applicable"</dmn:description>
          <dmn:text>Not offered</dmn:text>
        </dmn:outputEntry>
        <dmn:outputEntry>
          <dmn:description>–</dmn:description>
          <dmn:text>–</dmn:text>
        </dmn:outputEntry>
        <dmn:outputEntry>
          <dmn:description>–</dmn:description>
          <dmn:text>–</dmn:text>
        </dmn:outputEntry>
        <dmn:outputEntry>
          <dmn:description>–</dmn:description>
          <dmn:text>–</dmn:text>
        </dmn:outputEntry>
        <dmn:outputEntry>
          <dmn:description>L1</dmn:description>
          <dmn:text>unepi-deck.l1.yaml#C15</dmn:text>
        </dmn:outputEntry>
        <dmn:annotationEntry>
          <dmn:text>Open question 1: until what age is the childhood schedule offered? C15 says only 'no upper age limit for most vaccines'.</dmn:text>
        </dmn:annotationEntry>
      </dmn:rule>
    </dmn:decisionTable>
  </dmn:decision>
</dmn:definitions>
