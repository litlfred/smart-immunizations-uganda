<dmn:definitions xmlns:dmn="https://www.omg.org/spec/DMN/20240513/MODEL/" namespace="https://litlfred.github.io/smart-immunizations-uganda" label="UG.D18.S.OPV Oral polio vaccine schedule (Uganda)" id="UG.D18.S.OPV">
  <dmn:decision id="UG.D18.S.OPV" label="UG.D18.S.OPV Oral polio vaccine schedule (Uganda)">
    <dmn:question>Which Oral polio vaccine dose is the client due for, and when?</dmn:question>
    <dmn:decisionTable id="UG.D18.S.OPV.table">
      <dmn:input id="UG.D18.S.OPV.input.doses" label="Number of Oral polio vaccine doses administered">
        <dmn:inputExpression id="UG.D18.S.OPV.inputExpression.doses" typeRef="string">
          <dmn:text>Count of vaccines administered (where "Vaccine type" = "Oral polio vaccine")</dmn:text>
        </dmn:inputExpression>
      </dmn:input>
      <dmn:input id="UG.D18.S.OPV.input.age" label="Age">
        <dmn:inputExpression id="UG.D18.S.OPV.inputExpression.age" typeRef="string">
          <dmn:text>Today's date − "Date of birth"</dmn:text>
        </dmn:inputExpression>
      </dmn:input>
      <dmn:input id="UG.D18.S.OPV.input.applies" label="Applicability">
        <dmn:inputExpression id="UG.D18.S.OPV.inputExpression.applies" typeRef="string">
          <dmn:text>Client's age is below the childhood catch-up upper age (parameter, default 5 years)</dmn:text>
        </dmn:inputExpression>
      </dmn:input>
      <dmn:output id="UG.D18.S.OPV.output.status" label="Recommendation status">
        <dmn:description>Due, upcoming, expired or complete</dmn:description>
      </dmn:output>
      <dmn:output id="UG.D18.S.OPV.output.due" label="Due date">
        <dmn:description>Date from which the dose may be given</dmn:description>
      </dmn:output>
      <dmn:output id="UG.D18.S.OPV.output.expiration" label="Expiration">
        <dmn:description>Last date on which the dose may be given</dmn:description>
      </dmn:output>
      <dmn:output id="UG.D18.S.OPV.output.guidance" label="Guidance displayed to health worker">
        <dmn:description>Request to communicate guidance to the health worker</dmn:description>
      </dmn:output>
      <dmn:output id="UG.D18.S.OPV.output.references" label="Reference(s)">
        <dmn:description>The L1 statements the rule rests on, as &lt;l1 file&gt;#&lt;key&gt;</dmn:description>
      </dmn:output>
      <dmn:rule id="UG.D18.S.OPV.rule.dose0">
        <dmn:inputEntry>
          <dmn:description>= 0</dmn:description>
          <dmn:text>No dose administered</dmn:text>
        </dmn:inputEntry>
        <dmn:inputEntry>
          <dmn:description>–</dmn:description>
          <dmn:text>–</dmn:text>
        </dmn:inputEntry>
        <dmn:inputEntry>
          <dmn:description>Client's age is below the childhood catch-up upper age (parameter, default 5 years)</dmn:description>
          <dmn:text>Applies</dmn:text>
        </dmn:inputEntry>
        <dmn:outputEntry>
          <dmn:description>"Immunization recommendation status" = "Due" when Due date ≤ Today, else "Upcoming"</dmn:description>
          <dmn:text>Client is due for Oral polio vaccine dose 0</dmn:text>
        </dmn:outputEntry>
        <dmn:outputEntry>
          <dmn:description>Date of birth</dmn:description>
          <dmn:text>Date of birth</dmn:text>
        </dmn:outputEntry>
        <dmn:outputEntry>
          <dmn:description>OPV0: Date of birth + 1 week, and not once OPV1 is given; OPV1-3: none</dmn:description>
          <dmn:text>OPV0: Date of birth + 1 week, and not once OPV1 is given; OPV1-3: none</dmn:text>
        </dmn:outputEntry>
        <dmn:outputEntry>
          <dmn:description>Guidance</dmn:description>
          <dmn:text>Give OPV0 at birth. Oral.</dmn:text>
        </dmn:outputEntry>
        <dmn:outputEntry>
          <dmn:description>L1</dmn:description>
          <dmn:text>unepi-deck.l1.yaml#S03, ug-moh-schedule-poster.l1.yaml#P01, unepi-deck.l1.yaml#A01, unepi-deck.l1.yaml#C15</dmn:text>
        </dmn:outputEntry>
      </dmn:rule>
      <dmn:rule id="UG.D18.S.OPV.rule.dose1">
        <dmn:inputEntry>
          <dmn:description>= 1</dmn:description>
          <dmn:text>1 dose(s) administered</dmn:text>
        </dmn:inputEntry>
        <dmn:inputEntry>
          <dmn:description>–</dmn:description>
          <dmn:text>–</dmn:text>
        </dmn:inputEntry>
        <dmn:inputEntry>
          <dmn:description>Client's age is below the childhood catch-up upper age (parameter, default 5 years)</dmn:description>
          <dmn:text>Applies</dmn:text>
        </dmn:inputEntry>
        <dmn:outputEntry>
          <dmn:description>"Immunization recommendation status" = "Due" when Due date ≤ Today, else "Upcoming"</dmn:description>
          <dmn:text>Client is due for Oral polio vaccine dose 1</dmn:text>
        </dmn:outputEntry>
        <dmn:outputEntry>
          <dmn:description>Date of birth + 6 weeks</dmn:description>
          <dmn:text>Date of birth + 6 weeks</dmn:text>
        </dmn:outputEntry>
        <dmn:outputEntry>
          <dmn:description>OPV0: Date of birth + 1 week, and not once OPV1 is given; OPV1-3: none</dmn:description>
          <dmn:text>OPV0: Date of birth + 1 week, and not once OPV1 is given; OPV1-3: none</dmn:text>
        </dmn:outputEntry>
        <dmn:outputEntry>
          <dmn:description>Guidance</dmn:description>
          <dmn:text>At 6 weeks, or as soon as possible thereafter. Oral.</dmn:text>
        </dmn:outputEntry>
        <dmn:outputEntry>
          <dmn:description>L1</dmn:description>
          <dmn:text>unepi-deck.l1.yaml#S03, ug-moh-schedule-poster.l1.yaml#P02, unepi-deck.l1.yaml#C03, unepi-deck.l1.yaml#C15</dmn:text>
        </dmn:outputEntry>
      </dmn:rule>
      <dmn:rule id="UG.D18.S.OPV.rule.dose2">
        <dmn:inputEntry>
          <dmn:description>= 2</dmn:description>
          <dmn:text>2 dose(s) administered</dmn:text>
        </dmn:inputEntry>
        <dmn:inputEntry>
          <dmn:description>–</dmn:description>
          <dmn:text>–</dmn:text>
        </dmn:inputEntry>
        <dmn:inputEntry>
          <dmn:description>Client's age is below the childhood catch-up upper age (parameter, default 5 years)</dmn:description>
          <dmn:text>Applies</dmn:text>
        </dmn:inputEntry>
        <dmn:outputEntry>
          <dmn:description>"Immunization recommendation status" = "Due" when Due date ≤ Today, else "Upcoming"</dmn:description>
          <dmn:text>Client is due for Oral polio vaccine dose 2</dmn:text>
        </dmn:outputEntry>
        <dmn:outputEntry>
          <dmn:description>Latest of (Date of birth + 10 weeks, previous OPV + 4 weeks)</dmn:description>
          <dmn:text>Latest of (Date of birth + 10 weeks, previous OPV + 4 weeks)</dmn:text>
        </dmn:outputEntry>
        <dmn:outputEntry>
          <dmn:description>OPV0: Date of birth + 1 week, and not once OPV1 is given; OPV1-3: none</dmn:description>
          <dmn:text>OPV0: Date of birth + 1 week, and not once OPV1 is given; OPV1-3: none</dmn:text>
        </dmn:outputEntry>
        <dmn:outputEntry>
          <dmn:description>Guidance</dmn:description>
          <dmn:text>At 10 weeks, or as soon as possible thereafter, and at least 4 weeks after dose 1.</dmn:text>
        </dmn:outputEntry>
        <dmn:outputEntry>
          <dmn:description>L1</dmn:description>
          <dmn:text>unepi-deck.l1.yaml#S03, ug-moh-schedule-poster.l1.yaml#P03, unepi-deck.l1.yaml#C04, unepi-deck.l1.yaml#C10, unepi-deck.l1.yaml#C15</dmn:text>
        </dmn:outputEntry>
      </dmn:rule>
      <dmn:rule id="UG.D18.S.OPV.rule.dose3">
        <dmn:inputEntry>
          <dmn:description>= 3</dmn:description>
          <dmn:text>3 dose(s) administered</dmn:text>
        </dmn:inputEntry>
        <dmn:inputEntry>
          <dmn:description>–</dmn:description>
          <dmn:text>–</dmn:text>
        </dmn:inputEntry>
        <dmn:inputEntry>
          <dmn:description>Client's age is below the childhood catch-up upper age (parameter, default 5 years)</dmn:description>
          <dmn:text>Applies</dmn:text>
        </dmn:inputEntry>
        <dmn:outputEntry>
          <dmn:description>"Immunization recommendation status" = "Due" when Due date ≤ Today, else "Upcoming"</dmn:description>
          <dmn:text>Client is due for Oral polio vaccine dose 3</dmn:text>
        </dmn:outputEntry>
        <dmn:outputEntry>
          <dmn:description>Latest of (Date of birth + 14 weeks, previous OPV + 4 weeks)</dmn:description>
          <dmn:text>Latest of (Date of birth + 14 weeks, previous OPV + 4 weeks)</dmn:text>
        </dmn:outputEntry>
        <dmn:outputEntry>
          <dmn:description>OPV0: Date of birth + 1 week, and not once OPV1 is given; OPV1-3: none</dmn:description>
          <dmn:text>OPV0: Date of birth + 1 week, and not once OPV1 is given; OPV1-3: none</dmn:text>
        </dmn:outputEntry>
        <dmn:outputEntry>
          <dmn:description>Guidance</dmn:description>
          <dmn:text>At 14 weeks, or as soon as possible thereafter, and at least 4 weeks after dose 2.</dmn:text>
        </dmn:outputEntry>
        <dmn:outputEntry>
          <dmn:description>L1</dmn:description>
          <dmn:text>unepi-deck.l1.yaml#S03, ug-moh-schedule-poster.l1.yaml#P04, unepi-deck.l1.yaml#C05, unepi-deck.l1.yaml#C11, unepi-deck.l1.yaml#C15</dmn:text>
        </dmn:outputEntry>
      </dmn:rule>
      <dmn:rule id="UG.D18.S.OPV.rule.expired">
        <dmn:inputEntry>
          <dmn:description>&lt; 4</dmn:description>
          <dmn:text>Series not complete</dmn:text>
        </dmn:inputEntry>
        <dmn:inputEntry>
          <dmn:description>Today &gt; OPV0: Date of birth + 1 week, and not once OPV1 is given; OPV1-3: none</dmn:description>
          <dmn:text>Past the expiration</dmn:text>
        </dmn:inputEntry>
        <dmn:inputEntry>
          <dmn:description>Client's age is below the childhood catch-up upper age (parameter, default 5 years)</dmn:description>
          <dmn:text>Applies</dmn:text>
        </dmn:inputEntry>
        <dmn:outputEntry>
          <dmn:description>"Immunization recommendation status" = "Expired"</dmn:description>
          <dmn:text>Do not give Oral polio vaccine</dmn:text>
        </dmn:outputEntry>
        <dmn:outputEntry>
          <dmn:description>–</dmn:description>
          <dmn:text>–</dmn:text>
        </dmn:outputEntry>
        <dmn:outputEntry>
          <dmn:description>OPV0: Date of birth + 1 week, and not once OPV1 is given; OPV1-3: none</dmn:description>
          <dmn:text>OPV0: Date of birth + 1 week, and not once OPV1 is given; OPV1-3: none</dmn:text>
        </dmn:outputEntry>
        <dmn:outputEntry>
          <dmn:description>Guidance</dmn:description>
          <dmn:text>The next Oral polio vaccine dose may no longer be given.</dmn:text>
        </dmn:outputEntry>
        <dmn:outputEntry>
          <dmn:description>L1</dmn:description>
          <dmn:text>unepi-deck.l1.yaml#C15</dmn:text>
        </dmn:outputEntry>
        <dmn:annotationEntry>
          <dmn:text>Not stated in the Uganda sources; adapted from WHO IMMZ.D18.S.PolioBirthDose (expiration Date of birth + 1 week). Open question 3: is there a cut-off for OPV0?</dmn:text>
        </dmn:annotationEntry>
      </dmn:rule>
      <dmn:rule id="UG.D18.S.OPV.rule.complete">
        <dmn:inputEntry>
          <dmn:description>≥ 4</dmn:description>
          <dmn:text>Series complete</dmn:text>
        </dmn:inputEntry>
        <dmn:inputEntry>
          <dmn:description>–</dmn:description>
          <dmn:text>–</dmn:text>
        </dmn:inputEntry>
        <dmn:inputEntry>
          <dmn:description>–</dmn:description>
          <dmn:text>–</dmn:text>
        </dmn:inputEntry>
        <dmn:outputEntry>
          <dmn:description>"Immunization recommendation status" = "Complete"</dmn:description>
          <dmn:text>Oral polio vaccine series complete</dmn:text>
        </dmn:outputEntry>
        <dmn:outputEntry>
          <dmn:description>–</dmn:description>
          <dmn:text>–</dmn:text>
        </dmn:outputEntry>
        <dmn:outputEntry>
          <dmn:description>–</dmn:description>
          <dmn:text>–</dmn:text>
        </dmn:outputEntry>
        <dmn:outputEntry>
          <dmn:description>–</dmn:description>
          <dmn:text>–</dmn:text>
        </dmn:outputEntry>
        <dmn:outputEntry>
          <dmn:description>L1</dmn:description>
          <dmn:text>unepi-deck.l1.yaml#S03</dmn:text>
        </dmn:outputEntry>
      </dmn:rule>
      <dmn:rule id="UG.D18.S.OPV.rule.outOfScope">
        <dmn:inputEntry>
          <dmn:description>–</dmn:description>
          <dmn:text>–</dmn:text>
        </dmn:inputEntry>
        <dmn:inputEntry>
          <dmn:description>–</dmn:description>
          <dmn:text>–</dmn:text>
        </dmn:inputEntry>
        <dmn:inputEntry>
          <dmn:description>NOT (Client's age is below the childhood catch-up upper age (parameter, default 5 years))</dmn:description>
          <dmn:text>Childhood schedule does not apply</dmn:text>
        </dmn:inputEntry>
        <dmn:outputEntry>
          <dmn:description>"Immunization recommendation status" = "Not applicable"</dmn:description>
          <dmn:text>Not offered</dmn:text>
        </dmn:outputEntry>
        <dmn:outputEntry>
          <dmn:description>–</dmn:description>
          <dmn:text>–</dmn:text>
        </dmn:outputEntry>
        <dmn:outputEntry>
          <dmn:description>–</dmn:description>
          <dmn:text>–</dmn:text>
        </dmn:outputEntry>
        <dmn:outputEntry>
          <dmn:description>–</dmn:description>
          <dmn:text>–</dmn:text>
        </dmn:outputEntry>
        <dmn:outputEntry>
          <dmn:description>L1</dmn:description>
          <dmn:text>unepi-deck.l1.yaml#C15</dmn:text>
        </dmn:outputEntry>
        <dmn:annotationEntry>
          <dmn:text>Open question 1: until what age is the childhood schedule offered? C15 says only 'no upper age limit for most vaccines'.</dmn:text>
        </dmn:annotationEntry>
      </dmn:rule>
    </dmn:decisionTable>
  </dmn:decision>
</dmn:definitions>
